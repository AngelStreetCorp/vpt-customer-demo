# Customer branding and navigation — layered over the VM's frontend/.env at build time.
# Only VITE_* values (they are baked into the public bundle; never put secrets here).
VITE_PROJECT_NAME=Demo Customer
VITE_PROJECT_TAGLINE=Demo Customer — automated testing
VITE_PROJECT_TITLE=Demo Customer Test Platform
VITE_PROJECT_LOGO_URL=/brand/logo.svg
VITE_SHOW_FOOTER=true

# Core pages hidden for this customer (paths). Optional features are removed with
# DISABLED_FEATURES in customer.conf instead — that removes the code, this only hides a link.
VITE_NAV_HIDDEN=/integrations/jira,/integrations/slack
VITE_NAV_DISABLED=
VITE_NAV_COMING_SOON=
